# --- Media: heavy and personal (faces, voices). Never in Git. ---
source/*
!source/README.md
renders/

# --- Personal content: each person's projects and brands stay local ---
projects/*
!projects/README.md
brands/*
!brands/README.md
!brands/example.json
!brands/fonts/
brands/fonts/*
!brands/fonts/inter/

# --- Tool output ---
node_modules/
.hyperframes/
*.log

# --- Agent setup ---
# Unlike most repos, CLAUDE.md, .claude/skills/, .claude/agents/ and
# .claude/settings.json ARE the product here: they are what a cloned repo's
# Claude Code loads. Only the personal layer is ignored.
CLAUDE.local.md
.claude/settings.local.json
AGENTS.md
.mcp.json
.graphifyignore

